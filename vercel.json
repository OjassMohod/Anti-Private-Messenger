{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/*.js": { "maxDuration": 30 } },
  "rewrites": [
    { "source": "/message", "destination": "/index.html" },
    { "source": "/message/", "destination": "/index.html" },
    { "source": "/broadcast", "destination": "/index.html" },
    { "source": "/broadcast/", "destination": "/index.html" },
    { "source": "/inbox", "destination": "/index.html" },
    { "source": "/inbox/", "destination": "/index.html" },
    { "source": "/miscommunication-meter", "destination": "/index.html" },
    { "source": "/miscommunication-meter/", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
